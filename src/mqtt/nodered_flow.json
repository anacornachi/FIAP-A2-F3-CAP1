    {
        "id": "fn-alertas",
        "type": "function",
        "z": "2c2a5fea32af1753",
        "name": "Alertas",
        "func": "var data = JSON.parse(msg.payload);\nvar alertas = [];\nif (data.temp > 38) alertas.push('⚠️ Febre: ' + data.temp + '°C');\nif (data.bpm > 120) alertas.push('⚠️ Taquicardia: ' + data.bpm + ' BPM');\nif (data.bpm < 40) alertas.push('⚠️ Bradicardia: ' + data.bpm + ' BPM');\nif (data.umid > 80) alertas.push('⚠️ Umidade alta: ' + data.umid + '%');\nif (alertas.length > 0) {\n    msg.payload = alertas.join('\\n');\n} else {\n    msg.payload = '✅ Sinais vitais normais';\n}\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 320,
        "wires": [
            [
                "text-status"
            ]
        ]
    },
